const express = require("express");
const router = express.Router();

//Get All Donation Listings 
router.get("/", async (req, res) => {
  try {
    res.status(200),json({ message: "Fetched all donations successfully", data:[] });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

//Get Donation - Filter by ID
router.get("/:id", async (req, res) => {
  try {
    res.status(200),json({ message: "Fetched all donations with id ${id}", data:{} });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});


router.get("/", async (req,res) => {
  const { foodItem, quantity, expirationTime, pickupLocation } = req.body;

  if (!foodItem || !quantity) {
    return res.status(400).json({ error: "Food item and quantity are required fields."});
  }

  try{
    res.status(201).json({
      message: "Donation Listing created sucessfully!",
      data: { foodItem, quantity, expirationTime, pickupLocation }
    });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

router.put("/:id", async (req, res) => {
  const { id } = req.params;
  const { status } = req.body;

  try {
    res.status(200).json({ message: 'Donation ${id} updated successfully' });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

router.delete("/:id", async (req, res) => {
  const {id} = req.params;
  try {
    res.status(200).json({message: 'Donation ${id} deleted successfully' });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

module.exports = router; 
    
